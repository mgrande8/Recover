<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22505" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina6_12" orientation="portrait" appearance="dark"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22504"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="mainView">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <!-- Moon icon image -->
                            <imageView contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="SplashIcon" translatesAutoresizingMaskIntoConstraints="NO" id="moonImage">
                                <rect key="frame" x="96.5" y="280" width="200" height="124"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="200" id="moonW"/>
                                    <constraint firstAttribute="height" constant="124" id="moonH"/>
                                </constraints>
                            </imageView>
                            <!-- RECOVER label -->
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="RECOVER" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFitWidth="NO" translatesAutoresizingMaskIntoConstraints="NO" id="titleLabel">
                                <rect key="frame" x="96.5" y="424" width="200" height="40"/>
                                <fontDescription key="fontDescription" type="boldSystem" pointSize="38"/>
                                <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <!-- Sleep Better. Perform Better. label -->
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Sleep Better. Perform Better." textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFitWidth="NO" translatesAutoresizingMaskIntoConstraints="NO" id="taglineLabel">
                                <rect key="frame" x="96.5" y="484" width="200" height="20"/>
                                <fontDescription key="fontDescription" type="system" pointSize="16"/>
                                <color key="textColor" red="0.55" green="0.55" blue="0.6" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <color key="backgroundColor" red="0.039215686274509803" green="0.054901960784313725" blue="0.10196078431372549" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <!-- Moon: center horizontally -->
                            <constraint firstItem="moonImage" firstAttribute="centerX" secondItem="mainView" secondAttribute="centerX" id="moonCX"/>
                            <!-- Moon: center vertically with offset up -->
                            <constraint firstItem="moonImage" firstAttribute="centerY" secondItem="mainView" secondAttribute="centerY" constant="-80" id="moonCY"/>
                            <!-- Title: center horizontally -->
                            <constraint firstItem="titleLabel" firstAttribute="centerX" secondItem="mainView" secondAttribute="centerX" id="titleCX"/>
                            <!-- Title: 20pt below moon -->
                            <constraint firstItem="titleLabel" firstAttribute="top" secondItem="moonImage" secondAttribute="bottom" constant="20" id="titleTop"/>
                            <!-- Tagline: center horizontally -->
                            <constraint firstItem="taglineLabel" firstAttribute="centerX" secondItem="mainView" secondAttribute="centerX" id="tagCX"/>
                            <!-- Tagline: 16pt below title -->
                            <constraint firstItem="taglineLabel" firstAttribute="top" secondItem="titleLabel" secondAttribute="bottom" constant="16" id="tagTop"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
